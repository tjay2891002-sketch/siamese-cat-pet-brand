# 基米厨房环境变量说明
# 复制本文件为 .env 使用。注意：.env 含密钥，不要提交到 git。

# ---- 前端（VITE_ 前缀，会被打包进浏览器） ----
# 聊天后端地址：开发期走 vite 代理 /api（见 vite.config.ts），指向薄后台
VITE_DIFY_API_URL=/api

# ---- 服务端（server/index.mjs 读取，不带 VITE_ 前缀，不会进浏览器） ----
# Dify 应用的 API 地址（自托管默认 http://localhost/v1）
DIFY_API_URL=http://localhost/v1
# Dify 应用 API Key（Dify 控制台 → 应用 → 访问 API 生成）—— 真实 Key 只放这里，前端不可见
DIFY_API_KEY=
# 管理端查看线索的口令（GET /api/leads?token=...），随便设一个随机串
ADMIN_TOKEN=
# 薄后台端口（默认 8787）
# BACKEND_PORT=8787

# ---- 飞书通知 / 同步（可选）----
# 方式A：飞书群机器人 Webhook（转人工工单即时提醒），在群设置 → 群机器人 → 自定义中获取
NOTIFY_WEBHOOK_URL=
# 方式B：飞书多维表格线索沉淀（自建应用），先到飞书开放平台创建应用并获取以下三项
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 多维表格：在表格分享设置里拿到 app_token，点开数据表后从 URL 拿到 table_id
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# 多维表格需包含字段：时间 / 类型 / 猫名 / 年龄 / 体重 / 挑食 / 目标 / 联系方式 / 诉求 / 对话
# 方式C：新线索实时推送到飞书群（用方式B同款 app_id/app_secret）
# 建好「你+机器人」的自建群后，把群的 chat_id 填进来即可
FEISHU_CHAT_ID=
